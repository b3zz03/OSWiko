# OSWiko - configurazione kernel minimale per l'emulatore (QEMU "virt", ARM64)
# Uso: make allnoconfig KCONFIG_ALLCONFIG=kernel/qemu.config
CONFIG_LOCALVERSION="-oswiko"
CONFIG_DEFAULT_HOSTNAME="oswiko"
CONFIG_EXPERT=y
CONFIG_SMP=y
CONFIG_NR_CPUS=8
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_BUG=y
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_POSIX_TIMERS=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_ARM64_4K_PAGES=y
CONFIG_ARM_PSCI_FW=y
CONFIG_POWER_RESET=y

# Filesystem virtuali
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Console seriale PL011
CONFIG_TTY=y
CONFIG_VT=n
CONFIG_UNIX98_PTYS=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y

# Orologio
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_DRV_PL031=y

# Bus PCI e dispositivi virtio
CONFIG_PCI=y
CONFIG_PCI_HOST_GENERIC=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_INPUT=y

# Grafica: DRM virtio-gpu con /dev/fb0 emulato
CONFIG_DRM=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_VIRTIO_GPU_KMS=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_FB_DEVICE=y
CONFIG_FRAMEBUFFER_CONSOLE=n

# Input (touch/tastiera)
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=n
CONFIG_INPUT_MOUSE=n

# Rete (messaggi): virtio-net + DHCP integrato nel kernel (ip=dhcp)
CONFIG_NET=y
CONFIG_INET=y
CONFIG_UNIX=y
CONFIG_IPV6=n
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_VIRTIO_NET=y
CONFIG_IP_PNP=y
CONFIG_IP_PNP_DHCP=y
CONFIG_INOTIFY_USER=y
CONFIG_FILE_LOCKING=y

# Configurazione passata dall'emulatore (fw_cfg -> /sys/firmware/qemu_fw_cfg)
CONFIG_FW_CFG_SYSFS=y
